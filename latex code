\centering
\caption{Confusion Matrix}
\label{tbl:confusionMatrix}
\fontsize{12.0pt}{14.0pt}\selectfont
\begin{tabular}{lll}
\toprule
 & \multicolumn{2}{c}{{Actual}} \\ 
\cmidrule(lr){2-3}
Predicted & True & False \\ 
